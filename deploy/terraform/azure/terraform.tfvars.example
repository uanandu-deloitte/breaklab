# Copy to terraform.tfvars (gitignored) and fill in real values.
# See docs/devops-guide-azure.md for the full walkthrough.

learners = {
  "learner-01" = "203.0.113.5/32"
  "learner-02" = "203.0.113.9/32"
}

ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Optional — off by default. Uncomment once a cohort runs on a
# predictable schedule; pure cost control, never touches a learner's
# containers or files on disk. See docs/devops-guide-azure.md §7.
# auto_shutdown = {
#   enabled  = true
#   time     = "1900"
#   timezone = "UTC"
# }
